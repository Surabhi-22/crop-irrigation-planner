# CropWise — Frontend Environment Variables Template
# Copy this file to .env and fill in your Supabase project credentials.
# Never commit .env to version control.

# Supabase project URL (from Supabase Dashboard > Project Settings > API)
# Either full URL (https://<project-ref>.supabase.co) or project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable / anon key (safe for client-side browser usage)
# Supports both VITE_SUPABASE_PUBLISHABLE_KEY and legacy VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App URL for OAuth redirects (defaults to window.location.origin if omitted)
# Set this to your production domain before deploying.
# VITE_APP_URL=https://your-cropwise-app.com
